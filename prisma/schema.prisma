// ============================================================
// prisma/schema.prisma
// Prisma schema for baogiang-damsan
//
// Phase 01: Identity, access, organizational assignment, and audit foundation.
// Local Phase 02A: Versioned academic calendar and academic-year class foundation.
// Local Phase 03A: Academic-year teaching-assignment history foundation.
// Local Phase 04A1: Academic-year canonical wall-clock time-slot foundation.
//
// Database: PostgreSQL 17; connection supplied through DATABASE_URL per environment.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// System setting model for metadata and phase tracking
model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  DISABLED
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum AcademicWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimeSlotSession {
  MORNING
  AFTERNOON
  EVENING
}

enum TimetableVersionStatus {
  DRAFT
  VALIDATED
  APPROVED
  ACTIVE
  SUPERSEDED
}

enum PpctVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum OperationalOverlayStatus {
  ACTIVE
  REVERSED
}

enum CalendarExceptionScope {
  SCHOOL_WIDE
  GRADE
  CLASS
}

enum CalendarExceptionTimeSelector {
  WHOLE_DAY
  SESSION
  EXACT_SLOTS
}

enum OperationalLessonDispositionType {
  AUTHORIZED_CANCELLATION
  ABSENCE_NO_REPLACEMENT
  SAME_SUBJECT_SUBSTITUTION
  DIFFERENT_SUBJECT_SUPERVISION
}

enum SpecialActivityStatus {
  ACTIVE
  REVERSED
}

enum SpecialActivityScope {
  SCHOOL_WIDE
  GRADE
  CLASS
}

enum TeachingExecutionStatus {
  ACTIVE
  REVERSED
}

enum CurricularTeachingExecutionKind {
  NORMAL
  MAKEUP
}

enum ReportingStatementLifecycleState {
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ReportingStatementCommandType {
  SUBMIT
  APPROVE
  REJECT
}

enum ReportingStatementHistoryEvent {
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum TimetableImportTeacherIdentifierMode {
  GENERIC_EXACT
  STAFF_CODE
  USERNAME
  APPROVED_ALIAS
}

enum TimetableImportSemanticField {
  WEEKDAY
  SESSION
  PERIOD_ORDINAL
  SCHOOL_CLASS
  SUBJECT
  TEACHER
}

enum TimetableImportAliasEntityType {
  TEACHER
  SCHOOL_CLASS
  SUBJECT
}

enum AcademicWeekKind {
  OFFICIAL
  RESERVE
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILURE
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String     @unique @db.VarChar(100)
  passwordHash       String     @map("password_hash") @db.Text
  status             UserStatus @default(PENDING)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile                           StaffProfile?
  subjectGroupMemberships           SubjectGroupMembership[]
  staffSubjects                     StaffSubject[]
  capabilityGrants                  CapabilityGrant[]                       @relation("CapabilityGrantSubject")
  capabilityGrantsCreated           CapabilityGrant[]                       @relation("CapabilityGrantGrantedBy")
  capabilityGrantsRevoked           CapabilityGrant[]                       @relation("CapabilityGrantRevokedBy")
  authSessions                      AuthSession[]
  auditEvents                       AuditEvent[]                            @relation("AuditActor")
  additionalDutyAssignmentsCreated  StaffAdditionalDutyAssignment[]         @relation("AdditionalDutyAssignmentCreator")
  teachingAssignments               TeachingAssignment[]                    @relation("TeachingAssignmentTeacher")
  timetableVersionsCreated          TimetableVersion[]                      @relation("TimetableVersionCreatedBy")
  timetableVersionsValidated        TimetableVersion[]                      @relation("TimetableVersionValidatedBy")
  timetableVersionsApproved         TimetableVersion[]                      @relation("TimetableVersionApprovedBy")
  timetableVersionsActivated        TimetableVersion[]                      @relation("TimetableVersionActivatedBy")
  timetableEntriesAsTeacher         TimetableEntry[]                        @relation("TimetableEntryTeacher")
  timetableImportProfilesCreated    TimetableImportProfile[]                @relation("TimetableImportProfileCreatedBy")
  timetableImportRevisionsCreated   TimetableImportProfileRevision[]        @relation("TimetableImportProfileRevisionCreatedBy")
  timetableImportRevisionsRetired   TimetableImportProfileRevision[]        @relation("TimetableImportProfileRevisionRetiredBy")
  timetableImportAliasesAsTeacher   TimetableImportEntityAlias[]            @relation("TimetableImportAliasTeacher")
  timetableImportAliasesCreated     TimetableImportEntityAlias[]            @relation("TimetableImportAliasCreatedBy")
  timetableImportAliasesRetired     TimetableImportEntityAlias[]            @relation("TimetableImportAliasRetiredBy")
  timetableImportReceiptsCreated    TimetableImportReceipt[]                @relation("TimetableImportReceiptCreatedBy")
  ppctVersionsCreated               PpctVersion[]                           @relation("PpctVersionCreatedBy")
  ppctVersionsPublished             PpctVersion[]                           @relation("PpctVersionPublishedBy")
  ppctVersionsSuperseded            PpctVersion[]                           @relation("PpctVersionSupersededBy")
  ppctClassAssociationsCreated      PpctClassAssociation[]                  @relation("PpctClassAssociationCreatedBy")
  calendarExceptionsCreated         CalendarException[]                     @relation("CalendarExceptionCreatedBy")
  calendarExceptionsReversed        CalendarException[]                     @relation("CalendarExceptionReversedBy")
  lessonDispositionsCreated         OperationalLessonDisposition[]          @relation("LessonDispositionCreatedBy")
  lessonDispositionsReversed        OperationalLessonDisposition[]          @relation("LessonDispositionReversedBy")
  lessonDispositionsAssigned        OperationalLessonDisposition[]          @relation("LessonDispositionAssignedTeacher")
  makeupSchedulesCreated            MakeupTeachingSchedule[]                @relation("MakeupScheduleCreatedBy")
  makeupSchedulesReversed           MakeupTeachingSchedule[]                @relation("MakeupScheduleReversedBy")
  makeupSchedulesAsTeacher          MakeupTeachingSchedule[]                @relation("MakeupScheduleTeacher")
  specialActivitiesCreated          SpecialActivity[]                       @relation("SpecialActivityCreatedBy")
  specialActivitiesReversed         SpecialActivity[]                       @relation("SpecialActivityReversedBy")
  specialActivityStaffing           SpecialActivityStaffing[]               @relation("SpecialActivityScheduledTeacher")
  curricularExecutionsResponsible   CurricularTeachingExecution[]           @relation("CurricularExecutionResponsibleTeacher")
  curricularExecutionsActual        CurricularTeachingExecution[]           @relation("CurricularExecutionActualTeacher")
  curricularExecutionsCreated       CurricularTeachingExecution[]           @relation("CurricularExecutionCreatedBy")
  curricularExecutionsReversed      CurricularTeachingExecution[]           @relation("CurricularExecutionReversedBy")
  activityExecutionsActual          SpecialActivityParticipationExecution[] @relation("ActivityExecutionActualTeacher")
  activityExecutionsCreated         SpecialActivityParticipationExecution[] @relation("ActivityExecutionCreatedBy")
  activityExecutionsReversed        SpecialActivityParticipationExecution[] @relation("ActivityExecutionReversedBy")
  reportingStatementSeriesSubmitted ReportingStatementSeries[]              @relation("ReportingStatementSeriesSubmitter")
  reportingStatementCommands        ReportingStatementCommand[]             @relation("ReportingStatementCommandActor")
  reportingStatementHistories       ReportingStatementHistory[]             @relation("ReportingStatementHistoryActor")

  @@index([status])
  @@map("users")
}

model StaffProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  staffCode       String?  @unique @map("staff_code") @db.VarChar(50)
  displayName     String   @map("display_name") @db.VarChar(150)
  email           String?  @db.VarChar(254)
  phone           String?  @db.VarChar(30)
  positionTitle   String?  @map("position_title") @db.VarChar(150)
  isTeachingStaff Boolean  @default(true) @map("is_teaching_staff")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                      User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  additionalDutyAssignments StaffAdditionalDutyAssignment[]
  specialActivityStaffing   SpecialActivityStaffing[]

  @@unique([id, userId], map: "staff_profiles_id_user_id_key")
  @@map("staff_profiles")
}

model SubjectGroup {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique @db.VarChar(50)
  name      String        @db.VarChar(150)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships SubjectGroupMembership[]

  @@index([status, code])
  @@map("subject_groups")
}

model Subject {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique @db.VarChar(50)
  name      String        @db.VarChar(150)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  staffSubjects          StaffSubject[]
  teachingAssignments    TeachingAssignment[]
  timetableEntries       TimetableEntry[]
  timetableImportAliases TimetableImportEntityAlias[]
  ppctPlans              PpctPlan[]
  ppctClassAssociations  PpctClassAssociation[]

  reportingStatementRevisionSubjects ReportingStatementRevisionSubject[]

  @@index([status, code])
  @@map("subjects")
}

model SubjectGroupMembership {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  subjectGroupId String    @map("subject_group_id") @db.Uuid
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(3)
  isPrimary      Boolean   @default(false) @map("is_primary")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  subjectGroup SubjectGroup @relation(fields: [subjectGroupId], references: [id], onDelete: Restrict)

  @@index([userId, validFrom, validUntil])
  @@index([subjectGroupId, validFrom, validUntil])
  @@map("subject_group_memberships")
}

model StaffSubject {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  subjectId  String    @map("subject_id") @db.Uuid
  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                         User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  subject                      Subject                        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  lessonDispositionEligibility OperationalLessonDisposition[] @relation("LessonDispositionEligibilityStaffSubject")
  makeupScheduleEligibility    MakeupTeachingSchedule[]       @relation("MakeupScheduleEligibilityStaffSubject")

  @@unique([id, userId, subjectId], map: "staff_subjects_eligibility_provenance_key")
  @@index([userId, validFrom, validUntil])
  @@index([subjectId, validFrom, validUntil])
  @@map("staff_subjects")
}

model CapabilityDefinition {
  key               String   @id @db.VarChar(100)
  description       String   @db.Text
  allowedScopeTypes String[] @map("allowed_scope_types")
  isSystem          Boolean  @default(true) @map("is_system")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  grants CapabilityGrant[]

  @@index([isActive, key])
  @@map("capability_definitions")
}

model CapabilityGrant {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  capabilityKey   String    @map("capability_key") @db.VarChar(100)
  scopeType       String    @map("scope_type") @db.VarChar(50)
  scopeResourceId String?   @map("scope_resource_id") @db.Uuid
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil      DateTime? @map("valid_until") @db.Timestamptz(3)
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokeReason    String?   @map("revoke_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User                 @relation("CapabilityGrantSubject", fields: [userId], references: [id], onDelete: Restrict)
  capability CapabilityDefinition @relation(fields: [capabilityKey], references: [key], onDelete: Restrict)
  grantedBy  User?                @relation("CapabilityGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedBy  User?                @relation("CapabilityGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, capabilityKey, revokedAt, validFrom, validUntil])
  @@index([scopeType, scopeResourceId, validFrom, validUntil])
  @@map("capability_grants")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      String      @db.VarChar(100)
  entityType  String      @map("entity_type") @db.VarChar(100)
  entityId    String?     @map("entity_id") @db.VarChar(100)
  requestId   String?     @map("request_id") @db.VarChar(100)
  result      AuditResult @default(SUCCESS)
  metadata    Json?       @db.JsonB
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, result, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

model AdditionalDutyDefinition {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(150)
  description String?   @db.Text
  category    String    @db.VarChar(100)
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil  DateTime? @map("valid_until") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments StaffAdditionalDutyAssignment[]

  @@index([isActive, validFrom, validUntil, sortOrder])
  @@index([category, isActive])
  @@map("additional_duty_definitions")
}

model StaffAdditionalDutyAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  staffProfileId   String    @map("staff_profile_id") @db.Uuid
  dutyDefinitionId String    @map("duty_definition_id") @db.Uuid
  scopeType        String    @map("scope_type") @db.VarChar(50)
  scopeResourceId  String?   @map("scope_resource_id") @db.Uuid
  validFrom        DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil       DateTime? @map("valid_until") @db.Timestamptz(3)
  note             String?   @db.Text
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  staffProfile   StaffProfile             @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  dutyDefinition AdditionalDutyDefinition @relation(fields: [dutyDefinitionId], references: [id], onDelete: Restrict)
  createdBy      User                     @relation("AdditionalDutyAssignmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([staffProfileId, validFrom, validUntil])
  @@index([dutyDefinitionId, validFrom, validUntil])
  @@index([scopeType, scopeResourceId, validFrom, validUntil])
  @@map("staff_additional_duty_assignments")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  calendarVersions       AcademicCalendarVersion[]
  classes                SchoolClass[]
  teachingAssignments    TeachingAssignment[]
  timeSlotDefinitions    TimeSlotDefinition[]
  timetableVersions      TimetableVersion[]
  timetableEntries       TimetableEntry[]
  timetableImportAliases TimetableImportEntityAlias[]
  ppctPlans              PpctPlan[]
  ppctClassAssociations  PpctClassAssociation[]
  calendarExceptions     CalendarException[]
  calendarExceptionSlots CalendarExceptionTimeSlot[]
  specialActivities      SpecialActivity[]
  specialActivitySlots   SpecialActivityTimeSlot[]
  specialActivityTargets SpecialActivityClassTarget[]
  curricularExecutions   CurricularTeachingExecution[]
  activityExecutions     SpecialActivityParticipationExecution[]

  reportingStatementSeries ReportingStatementSeries[]

  @@map("academic_years")
}

model TimeSlotDefinition {
  id                   String          @id @default(uuid()) @db.Uuid
  academicYearId       String          @map("academic_year_id") @db.Uuid
  weekday              AcademicWeekday
  session              TimeSlotSession
  ordinal              Int
  revision             Int             @default(1)
  displayLabel         String          @map("display_label") @db.VarChar(50)
  startTime            DateTime        @map("start_time") @db.Time(0)
  endTime              DateTime        @map("end_time") @db.Time(0)
  isActive             Boolean         @default(true) @map("is_active")
  allowRegularTeaching Boolean         @default(true) @map("allow_regular_teaching")
  allowMakeupTeaching  Boolean         @default(false) @map("allow_makeup_teaching")
  allowSelfStudy       Boolean         @default(false) @map("allow_self_study")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear           AcademicYear                            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  timetableEntries       TimetableEntry[]                        @relation("TimetableEntryTimeSlot")
  calendarExceptionSlots CalendarExceptionTimeSlot[]             @relation("CalendarExceptionExactTimeSlot")
  makeupScheduleTargets  MakeupTeachingSchedule[]                @relation("MakeupScheduleTargetTimeSlot")
  specialActivitySlots   SpecialActivityTimeSlot[]
  curricularExecutions   CurricularTeachingExecution[]           @relation("CurricularExecutionTimeSlot")
  activityExecutions     SpecialActivityParticipationExecution[] @relation("ActivityExecutionTimeSlot")

  @@unique([id, academicYearId], map: "time_slot_definitions_id_academic_year_id_key")
  @@unique([id, academicYearId, weekday], map: "time_slot_definitions_id_academic_year_id_weekday_key")
  @@unique([academicYearId, weekday, session, ordinal, revision], map: "time_slot_definitions_logical_revision_key")
  @@index([academicYearId, weekday, session, isActive], map: "time_slot_definitions_year_weekday_session_active_idx")
  @@map("time_slot_definitions")
}

model AcademicCalendarVersion {
  id                String            @id @default(uuid()) @db.Uuid
  academicYearId    String            @map("academic_year_id") @db.Uuid
  versionNumber     Int               @map("version_number")
  startDate         DateTime          @map("start_date") @db.Date
  endDate           DateTime          @map("end_date") @db.Date
  officialWeekCount Int               @map("official_week_count")
  reserveWeekCount  Int               @map("reserve_week_count")
  teachingWeekdays  AcademicWeekday[] @map("teaching_weekdays")
  isActive          Boolean           @default(false) @map("is_active")
  activatedAt       DateTime?         @map("activated_at") @db.Timestamptz(3)
  note              String?           @db.Text
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear            AcademicYear                            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  semesters               Semester[]
  weeks                   AcademicWeek[]
  interruptions           CalendarInterruption[]
  timetableVersions       TimetableVersion[]                      @relation("TimetableVersionCalendarSnapshot")
  calendarExceptions      CalendarException[]                     @relation("CalendarExceptionCalendarVersion")
  lessonDispositions      OperationalLessonDisposition[]          @relation("LessonDispositionCalendarVersion")
  makeupOriginalSchedules MakeupTeachingSchedule[]                @relation("MakeupScheduleOriginalCalendarVersion")
  makeupTargetSchedules   MakeupTeachingSchedule[]                @relation("MakeupScheduleTargetCalendarVersion")
  specialActivities       SpecialActivity[]
  curricularExecutions    CurricularTeachingExecution[]           @relation("CurricularExecutionCalendar")
  activityExecutions      SpecialActivityParticipationExecution[] @relation("ActivityExecutionCalendar")

  @@unique([id, academicYearId], map: "academic_calendar_versions_id_academic_year_id_key")
  @@unique([academicYearId, versionNumber])
  @@index([academicYearId, isActive])
  @@map("academic_calendar_versions")
}

model Semester {
  id                String   @id @default(uuid()) @db.Uuid
  calendarVersionId String   @map("calendar_version_id") @db.Uuid
  code              String   @db.VarChar(30)
  name              String   @db.VarChar(150)
  ordinal           Int
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  calendarVersion AcademicCalendarVersion @relation(fields: [calendarVersionId], references: [id], onDelete: Restrict)

  @@unique([calendarVersionId, code])
  @@unique([calendarVersionId, ordinal])
  @@index([calendarVersionId, startDate, endDate])
  @@map("semesters")
}

model AcademicWeek {
  id                 String           @id @default(uuid()) @db.Uuid
  calendarVersionId  String           @map("calendar_version_id") @db.Uuid
  kind               AcademicWeekKind
  officialWeekNumber Int?             @map("official_week_number")
  reserveWeekNumber  Int?             @map("reserve_week_number")
  displayLabel       String           @map("display_label") @db.VarChar(50)
  sortOrder          Int              @map("sort_order")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  calendarVersion            AcademicCalendarVersion                 @relation(fields: [calendarVersionId], references: [id], onDelete: Restrict)
  segments                   AcademicWeekSegment[]                   @relation("AcademicWeekSegments")
  effectiveTimetableVersions TimetableVersion[]                      @relation("TimetableVersionEffectiveWeek")
  curricularExecutions       CurricularTeachingExecution[]           @relation("CurricularExecutionWeek")
  activityExecutions         SpecialActivityParticipationExecution[] @relation("ActivityExecutionWeek")

  @@unique([id, calendarVersionId])
  @@unique([calendarVersionId, displayLabel])
  @@unique([calendarVersionId, sortOrder])
  @@index([calendarVersionId, kind])
  @@map("academic_weeks")
}

model AcademicWeekSegment {
