// ============================================================
// prisma/schema.prisma
// Prisma schema for baogiang-damsan
//
// Phase 01: Identity, access, organizational assignment, and audit foundation.
// Local Phase 02A: Versioned academic calendar and academic-year class foundation.
// Local Phase 03A: Academic-year teaching-assignment history foundation.
// Local Phase 04A1: Academic-year canonical wall-clock time-slot foundation.
//
// Database: PostgreSQL 17; connection supplied through DATABASE_URL per environment.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// System setting model for metadata and phase tracking
model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  DISABLED
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum AcademicWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimeSlotSession {
  MORNING
  AFTERNOON
  EVENING
}

enum TimetableVersionStatus {
  DRAFT
  VALIDATED
  APPROVED
  ACTIVE
  SUPERSEDED
}

enum TimetableImportTeacherIdentifierMode {
  GENERIC_EXACT
  STAFF_CODE
  USERNAME
  APPROVED_ALIAS
}

enum TimetableImportSemanticField {
  WEEKDAY
  SESSION
  PERIOD_ORDINAL
  SCHOOL_CLASS
  SUBJECT
  TEACHER
}

enum TimetableImportAliasEntityType {
  TEACHER
  SCHOOL_CLASS
  SUBJECT
}

enum AcademicWeekKind {
  OFFICIAL
  RESERVE
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILURE
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String     @unique @db.VarChar(100)
  passwordHash       String     @map("password_hash") @db.Text
  status             UserStatus @default(PENDING)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile                          StaffProfile?
  subjectGroupMemberships          SubjectGroupMembership[]
  staffSubjects                    StaffSubject[]
  capabilityGrants                 CapabilityGrant[]                @relation("CapabilityGrantSubject")
  capabilityGrantsCreated          CapabilityGrant[]                @relation("CapabilityGrantGrantedBy")
  capabilityGrantsRevoked          CapabilityGrant[]                @relation("CapabilityGrantRevokedBy")
  authSessions                     AuthSession[]
  auditEvents                      AuditEvent[]                     @relation("AuditActor")
  additionalDutyAssignmentsCreated StaffAdditionalDutyAssignment[]  @relation("AdditionalDutyAssignmentCreator")
  teachingAssignments              TeachingAssignment[]             @relation("TeachingAssignmentTeacher")
  timetableVersionsCreated         TimetableVersion[]               @relation("TimetableVersionCreatedBy")
  timetableVersionsValidated       TimetableVersion[]               @relation("TimetableVersionValidatedBy")
  timetableVersionsApproved        TimetableVersion[]               @relation("TimetableVersionApprovedBy")
  timetableVersionsActivated       TimetableVersion[]               @relation("TimetableVersionActivatedBy")
  timetableEntriesAsTeacher        TimetableEntry[]                 @relation("TimetableEntryTeacher")
  timetableImportProfilesCreated   TimetableImportProfile[]         @relation("TimetableImportProfileCreatedBy")
  timetableImportRevisionsCreated  TimetableImportProfileRevision[] @relation("TimetableImportProfileRevisionCreatedBy")
  timetableImportRevisionsRetired  TimetableImportProfileRevision[] @relation("TimetableImportProfileRevisionRetiredBy")
  timetableImportAliasesAsTeacher  TimetableImportEntityAlias[]     @relation("TimetableImportAliasTeacher")
  timetableImportAliasesCreated    TimetableImportEntityAlias[]     @relation("TimetableImportAliasCreatedBy")
  timetableImportAliasesRetired    TimetableImportEntityAlias[]     @relation("TimetableImportAliasRetiredBy")
  timetableImportReceiptsCreated   TimetableImportReceipt[]         @relation("TimetableImportReceiptCreatedBy")

  @@index([status])
  @@map("users")
}

model StaffProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  staffCode       String?  @unique @map("staff_code") @db.VarChar(50)
  displayName     String   @map("display_name") @db.VarChar(150)
  email           String?  @db.VarChar(254)
  phone           String?  @db.VarChar(30)
  positionTitle   String?  @map("position_title") @db.VarChar(150)
  isTeachingStaff Boolean  @default(true) @map("is_teaching_staff")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                      User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  additionalDutyAssignments StaffAdditionalDutyAssignment[]

  @@map("staff_profiles")
}

model SubjectGroup {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique @db.VarChar(50)
  name      String        @db.VarChar(150)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships SubjectGroupMembership[]

  @@index([status, code])
  @@map("subject_groups")
}

model Subject {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique @db.VarChar(50)
  name      String        @db.VarChar(150)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  staffSubjects          StaffSubject[]
  teachingAssignments    TeachingAssignment[]
  timetableEntries       TimetableEntry[]
  timetableImportAliases TimetableImportEntityAlias[]

  @@index([status, code])
  @@map("subjects")
}

model SubjectGroupMembership {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  subjectGroupId String    @map("subject_group_id") @db.Uuid
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(3)
  isPrimary      Boolean   @default(false) @map("is_primary")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  subjectGroup SubjectGroup @relation(fields: [subjectGroupId], references: [id], onDelete: Restrict)

  @@index([userId, validFrom, validUntil])
  @@index([subjectGroupId, validFrom, validUntil])
  @@map("subject_group_memberships")
}

model StaffSubject {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  subjectId  String    @map("subject_id") @db.Uuid
  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([userId, validFrom, validUntil])
  @@index([subjectId, validFrom, validUntil])
  @@map("staff_subjects")
}

model CapabilityDefinition {
  key               String   @id @db.VarChar(100)
  description       String   @db.Text
  allowedScopeTypes String[] @map("allowed_scope_types")
  isSystem          Boolean  @default(true) @map("is_system")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  grants CapabilityGrant[]

  @@index([isActive, key])
  @@map("capability_definitions")
}

model CapabilityGrant {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  capabilityKey   String    @map("capability_key") @db.VarChar(100)
  scopeType       String    @map("scope_type") @db.VarChar(50)
  scopeResourceId String?   @map("scope_resource_id") @db.Uuid
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil      DateTime? @map("valid_until") @db.Timestamptz(3)
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokeReason    String?   @map("revoke_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User                 @relation("CapabilityGrantSubject", fields: [userId], references: [id], onDelete: Restrict)
  capability CapabilityDefinition @relation(fields: [capabilityKey], references: [key], onDelete: Restrict)
  grantedBy  User?                @relation("CapabilityGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedBy  User?                @relation("CapabilityGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, capabilityKey, revokedAt, validFrom, validUntil])
  @@index([scopeType, scopeResourceId, validFrom, validUntil])
  @@map("capability_grants")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      String      @db.VarChar(100)
  entityType  String      @map("entity_type") @db.VarChar(100)
  entityId    String?     @map("entity_id") @db.VarChar(100)
  requestId   String?     @map("request_id") @db.VarChar(100)
  result      AuditResult @default(SUCCESS)
  metadata    Json?       @db.JsonB
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, result, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

model AdditionalDutyDefinition {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(150)
  description String?   @db.Text
  category    String    @db.VarChar(100)
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil  DateTime? @map("valid_until") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments StaffAdditionalDutyAssignment[]

  @@index([isActive, validFrom, validUntil, sortOrder])
  @@index([category, isActive])
  @@map("additional_duty_definitions")
}

model StaffAdditionalDutyAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  staffProfileId   String    @map("staff_profile_id") @db.Uuid
  dutyDefinitionId String    @map("duty_definition_id") @db.Uuid
  scopeType        String    @map("scope_type") @db.VarChar(50)
  scopeResourceId  String?   @map("scope_resource_id") @db.Uuid
  validFrom        DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil       DateTime? @map("valid_until") @db.Timestamptz(3)
  note             String?   @db.Text
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  staffProfile   StaffProfile             @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  dutyDefinition AdditionalDutyDefinition @relation(fields: [dutyDefinitionId], references: [id], onDelete: Restrict)
  createdBy      User                     @relation("AdditionalDutyAssignmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([staffProfileId, validFrom, validUntil])
  @@index([dutyDefinitionId, validFrom, validUntil])
  @@index([scopeType, scopeResourceId, validFrom, validUntil])
  @@map("staff_additional_duty_assignments")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  calendarVersions       AcademicCalendarVersion[]
  classes                SchoolClass[]
  teachingAssignments    TeachingAssignment[]
  timeSlotDefinitions    TimeSlotDefinition[]
  timetableVersions      TimetableVersion[]
  timetableEntries       TimetableEntry[]
  timetableImportAliases TimetableImportEntityAlias[]

  @@map("academic_years")
}

model TimeSlotDefinition {
  id                   String          @id @default(uuid()) @db.Uuid
  academicYearId       String          @map("academic_year_id") @db.Uuid
  weekday              AcademicWeekday
  session              TimeSlotSession
  ordinal              Int
  revision             Int             @default(1)
  displayLabel         String          @map("display_label") @db.VarChar(50)
  startTime            DateTime        @map("start_time") @db.Time(0)
  endTime              DateTime        @map("end_time") @db.Time(0)
  isActive             Boolean         @default(true) @map("is_active")
  allowRegularTeaching Boolean         @default(true) @map("allow_regular_teaching")
  allowMakeupTeaching  Boolean         @default(false) @map("allow_makeup_teaching")
  allowSelfStudy       Boolean         @default(false) @map("allow_self_study")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  timetableEntries TimetableEntry[] @relation("TimetableEntryTimeSlot")

  @@unique([id, academicYearId], map: "time_slot_definitions_id_academic_year_id_key")
  @@unique([id, academicYearId, weekday], map: "time_slot_definitions_id_academic_year_id_weekday_key")
  @@unique([academicYearId, weekday, session, ordinal, revision], map: "time_slot_definitions_logical_revision_key")
  @@index([academicYearId, weekday, session, isActive], map: "time_slot_definitions_year_weekday_session_active_idx")
  @@map("time_slot_definitions")
}

model AcademicCalendarVersion {
  id                String            @id @default(uuid()) @db.Uuid
  academicYearId    String            @map("academic_year_id") @db.Uuid
  versionNumber     Int               @map("version_number")
  startDate         DateTime          @map("start_date") @db.Date
  endDate           DateTime          @map("end_date") @db.Date
  officialWeekCount Int               @map("official_week_count")
  reserveWeekCount  Int               @map("reserve_week_count")
  teachingWeekdays  AcademicWeekday[] @map("teaching_weekdays")
  isActive          Boolean           @default(false) @map("is_active")
  activatedAt       DateTime?         @map("activated_at") @db.Timestamptz(3)
  note              String?           @db.Text
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear      AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  semesters         Semester[]
  weeks             AcademicWeek[]
  interruptions     CalendarInterruption[]
  timetableVersions TimetableVersion[]     @relation("TimetableVersionCalendarSnapshot")

  @@unique([id, academicYearId], map: "academic_calendar_versions_id_academic_year_id_key")
  @@unique([academicYearId, versionNumber])
  @@index([academicYearId, isActive])
  @@map("academic_calendar_versions")
}

model Semester {
  id                String   @id @default(uuid()) @db.Uuid
  calendarVersionId String   @map("calendar_version_id") @db.Uuid
  code              String   @db.VarChar(30)
  name              String   @db.VarChar(150)
  ordinal           Int
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  calendarVersion AcademicCalendarVersion @relation(fields: [calendarVersionId], references: [id], onDelete: Restrict)

  @@unique([calendarVersionId, code])
  @@unique([calendarVersionId, ordinal])
  @@index([calendarVersionId, startDate, endDate])
  @@map("semesters")
}

model AcademicWeek {
  id                 String           @id @default(uuid()) @db.Uuid
  calendarVersionId  String           @map("calendar_version_id") @db.Uuid
  kind               AcademicWeekKind
  officialWeekNumber Int?             @map("official_week_number")
  reserveWeekNumber  Int?             @map("reserve_week_number")
  displayLabel       String           @map("display_label") @db.VarChar(50)
  sortOrder          Int              @map("sort_order")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  calendarVersion            AcademicCalendarVersion @relation(fields: [calendarVersionId], references: [id], onDelete: Restrict)
  segments                   AcademicWeekSegment[]   @relation("AcademicWeekSegments")
  effectiveTimetableVersions TimetableVersion[]      @relation("TimetableVersionEffectiveWeek")

  @@unique([id, calendarVersionId])
  @@unique([calendarVersionId, displayLabel])
  @@unique([calendarVersionId, sortOrder])
  @@index([calendarVersionId, kind])
  @@map("academic_weeks")
}

model AcademicWeekSegment {
  id                String   @id @default(uuid()) @db.Uuid
  academicWeekId    String   @map("academic_week_id") @db.Uuid
  calendarVersionId String   @map("calendar_version_id") @db.Uuid
  label             String   @db.VarChar(50)
  segmentOrder      Int      @map("segment_order")
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicWeek AcademicWeek @relation("AcademicWeekSegments", fields: [academicWeekId, calendarVersionId], references: [id, calendarVersionId], onDelete: Restrict)

  @@unique([academicWeekId, label])
  @@unique([academicWeekId, segmentOrder])
  @@index([calendarVersionId, startDate, endDate], map: "academic_week_segments_version_dates_idx")
  @@map("academic_week_segments")
}

model CalendarInterruption {
  id                String   @id @default(uuid()) @db.Uuid
  calendarVersionId String   @map("calendar_version_id") @db.Uuid
  code              String   @db.VarChar(50)
  name              String   @db.VarChar(150)
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  calendarVersion AcademicCalendarVersion @relation(fields: [calendarVersionId], references: [id], onDelete: Restrict)

  @@unique([calendarVersionId, code])
  @@index([calendarVersionId, startDate, endDate], map: "calendar_interruptions_version_dates_idx")
  @@map("calendar_interruptions")
}

model SchoolClass {
  id             String        @id @default(uuid()) @db.Uuid
  academicYearId String        @map("academic_year_id") @db.Uuid
  code           String        @db.VarChar(50)
  name           String        @db.VarChar(150)
  gradeLevel     Int           @map("grade_level")
  status         CatalogStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear           AcademicYear                 @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  teachingAssignments    TeachingAssignment[]         @relation("TeachingAssignmentSchoolClass")
  timetableEntries       TimetableEntry[]             @relation("TimetableEntrySchoolClass")
  timetableImportAliases TimetableImportEntityAlias[] @relation("TimetableImportAliasSchoolClass")

  @@unique([id, academicYearId])
  @@unique([academicYearId, code])
  @@index([academicYearId, status, gradeLevel, code])
  @@map("classes")
}

model TeachingAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  schoolClassId  String    @map("school_class_id") @db.Uuid
  subjectId      String    @map("subject_id") @db.Uuid
  teacherUserId  String    @map("teacher_user_id") @db.Uuid
  validFrom      DateTime  @map("valid_from") @db.Date
  validUntil     DateTime? @map("valid_until") @db.Date
  note           String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass      SchoolClass      @relation("TeachingAssignmentSchoolClass", fields: [schoolClassId, academicYearId], references: [id, academicYearId], onDelete: Restrict)
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher          User             @relation("TeachingAssignmentTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  timetableEntries TimetableEntry[] @relation("TimetableEntryAssignment")

  @@unique([id, academicYearId, schoolClassId, subjectId, teacherUserId], map: "teaching_assignments_provenance_key")
  @@index([academicYearId, schoolClassId, subjectId, validFrom, validUntil], map: "teaching_assignments_class_subject_validity_idx")
  @@index([teacherUserId, academicYearId, validFrom, validUntil], map: "teaching_assignments_teacher_year_validity_idx")
  @@index([subjectId, academicYearId, validFrom, validUntil], map: "teaching_assignments_subject_year_validity_idx")
  @@map("teaching_assignments")
}

model TimetableVersion {
  id                      String                 @id @default(uuid()) @db.Uuid
  academicYearId          String                 @map("academic_year_id") @db.Uuid
  versionNumber           Int                    @map("version_number")
  status                  TimetableVersionStatus @default(DRAFT)
  calendarVersionId       String?                @map("calendar_version_id") @db.Uuid
  effectiveAcademicWeekId String?                @map("effective_academic_week_id") @db.Uuid
  effectiveFrom           DateTime?              @map("effective_from") @db.Date
  effectiveUntil          DateTime?              @map("effective_until") @db.Date
  contentChecksum         String?                @map("content_checksum") @db.VarChar(128)
  note                    String?                @db.Text
  createdByUserId         String                 @map("created_by_user_id") @db.Uuid
  validatedByUserId       String?                @map("validated_by_user_id") @db.Uuid
  validatedAt             DateTime?              @map("validated_at") @db.Timestamptz(3)
  approvedByUserId        String?                @map("approved_by_user_id") @db.Uuid
  approvedAt              DateTime?              @map("approved_at") @db.Timestamptz(3)
  activatedByUserId       String?                @map("activated_by_user_id") @db.Uuid
  activatedAt             DateTime?              @map("activated_at") @db.Timestamptz(3)
  supersededAt            DateTime?              @map("superseded_at") @db.Timestamptz(3)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear          AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  calendarVersion       AcademicCalendarVersion? @relation("TimetableVersionCalendarSnapshot", fields: [calendarVersionId, academicYearId], references: [id, academicYearId], onDelete: Restrict)
  effectiveAcademicWeek AcademicWeek?            @relation("TimetableVersionEffectiveWeek", fields: [effectiveAcademicWeekId, calendarVersionId], references: [id, calendarVersionId], onDelete: Restrict)
  createdBy             User                     @relation("TimetableVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  validatedBy           User?                    @relation("TimetableVersionValidatedBy", fields: [validatedByUserId], references: [id], onDelete: Restrict)
  approvedBy            User?                    @relation("TimetableVersionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  activatedBy           User?                    @relation("TimetableVersionActivatedBy", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  entries               TimetableEntry[]         @relation("TimetableEntryVersion")
  importReceipt         TimetableImportReceipt?  @relation("TimetableImportReceiptVersion")

  @@unique([id, academicYearId], map: "timetable_versions_id_academic_year_id_key")
  @@unique([academicYearId, versionNumber], map: "timetable_versions_academic_year_id_version_number_key")
  @@unique([academicYearId, calendarVersionId, effectiveAcademicWeekId, contentChecksum], map: "timetable_versions_import_semantic_duplicate_key")
  @@index([academicYearId, status], map: "timetable_versions_academic_year_id_status_idx")
  @@index([calendarVersionId, effectiveAcademicWeekId], map: "timetable_versions_calendar_version_id_effective_week_id_idx")
  @@index([contentChecksum], map: "timetable_versions_content_checksum_idx")
  @@map("timetable_versions")
}

model TimetableImportProfile {
  id              String   @id @default(uuid()) @db.Uuid
  sourceKey       String   @map("source_key") @db.VarChar(100)
  name            String   @db.VarChar(150)
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User                             @relation("TimetableImportProfileCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revisions TimetableImportProfileRevision[]
  aliases   TimetableImportEntityAlias[]

  @@unique([sourceKey, name], map: "timetable_import_profiles_source_key_name_key")
  @@index([sourceKey, name], map: "timetable_import_profiles_source_key_name_idx")
  @@map("timetable_import_profiles")
}

model TimetableImportProfileRevision {
  id                    String                               @id @default(uuid()) @db.Uuid
  profileId             String                               @map("profile_id") @db.Uuid
  revision              Int
  isActive              Boolean                              @default(true) @map("is_active")
  sheetNameHint         String?                              @map("sheet_name_hint") @db.VarChar(150)
  headerRowHint         Int?                                 @map("header_row_hint")
  teacherIdentifierMode TimetableImportTeacherIdentifierMode @map("teacher_identifier_mode")
  createdByUserId       String                               @map("created_by_user_id") @db.Uuid
  retiredByUserId       String?                              @map("retired_by_user_id") @db.Uuid
  retiredAt             DateTime?                            @map("retired_at") @db.Timestamptz(3)
  createdAt             DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)

  profile        TimetableImportProfile         @relation(fields: [profileId], references: [id], onDelete: Restrict)
  createdBy      User                           @relation("TimetableImportProfileRevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  retiredBy      User?                          @relation("TimetableImportProfileRevisionRetiredBy", fields: [retiredByUserId], references: [id], onDelete: Restrict)
  columnMappings TimetableImportColumnMapping[]
  receipts       TimetableImportReceipt[]

  @@unique([profileId, revision], map: "timetable_import_profile_revisions_profile_revision_key")
  @@index([profileId, isActive], map: "timetable_import_profile_revisions_profile_active_idx")
  @@map("timetable_import_profile_revisions")
}

model TimetableImportColumnMapping {
  id                String                       @id @default(uuid()) @db.Uuid
  profileRevisionId String                       @map("profile_revision_id") @db.Uuid
  semanticField     TimetableImportSemanticField @map("semantic_field")
  sourceHeader      String                       @map("source_header") @db.VarChar(150)
  sourceHeaderKey   String                       @map("source_header_key") @db.VarChar(150)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)

  profileRevision TimetableImportProfileRevision @relation(fields: [profileRevisionId], references: [id], onDelete: Restrict)

  @@unique([profileRevisionId, semanticField], map: "timetable_import_column_mappings_revision_field_key")
  @@unique([profileRevisionId, sourceHeaderKey], map: "timetable_import_column_mappings_revision_source_key")
  @@map("timetable_import_column_mappings")
}

model TimetableImportEntityAlias {
  id              String                         @id @default(uuid()) @db.Uuid
  profileId       String                         @map("profile_id") @db.Uuid
  entityType      TimetableImportAliasEntityType @map("entity_type")
  academicYearId  String?                        @map("academic_year_id") @db.Uuid
  sourceValue     String                         @map("source_value") @db.VarChar(200)
  sourceValueKey  String                         @map("source_value_key") @db.VarChar(200)
  teacherUserId   String?                        @map("teacher_user_id") @db.Uuid
  schoolClassId   String?                        @map("school_class_id") @db.Uuid
  subjectId       String?                        @map("subject_id") @db.Uuid
  isActive        Boolean                        @default(true) @map("is_active")
  createdByUserId String                         @map("created_by_user_id") @db.Uuid
  retiredByUserId String?                        @map("retired_by_user_id") @db.Uuid
  retiredAt       DateTime?                      @map("retired_at") @db.Timestamptz(3)
  createdAt       DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)

  profile      TimetableImportProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  academicYear AcademicYear?          @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  teacher      User?                  @relation("TimetableImportAliasTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  schoolClass  SchoolClass?           @relation("TimetableImportAliasSchoolClass", fields: [schoolClassId, academicYearId], references: [id, academicYearId], onDelete: Restrict)
  subject      Subject?               @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy    User                   @relation("TimetableImportAliasCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  retiredBy    User?                  @relation("TimetableImportAliasRetiredBy", fields: [retiredByUserId], references: [id], onDelete: Restrict)

  @@index([profileId, entityType, isActive], map: "timetable_import_entity_aliases_profile_entity_active_idx")
  @@index([academicYearId, schoolClassId], map: "timetable_import_entity_aliases_year_class_idx")
  @@map("timetable_import_entity_aliases")
}

model TimetableImportReceipt {
  id                    String   @id @default(uuid()) @db.Uuid
  timetableVersionId    String   @unique(map: "timetable_import_receipts_timetable_version_id_key") @map("timetable_version_id") @db.Uuid
  profileRevisionId     String   @map("profile_revision_id") @db.Uuid
  checksumAlgorithm     String   @map("checksum_algorithm") @db.VarChar(20)
  serializationVersion  String   @map("serialization_version") @db.VarChar(30)
  requestIdempotencyKey String?  @unique(map: "timetable_import_receipts_request_idempotency_key_key") @map("request_idempotency_key") @db.VarChar(200)
  requestFingerprint    String?  @map("request_fingerprint") @db.VarChar(128)
  sourceFileName        String   @map("source_file_name") @db.VarChar(255)
  sheetName             String   @map("sheet_name") @db.VarChar(150)
  headerRowNumber       Int      @map("header_row_number")
  sourceRowCount        Int      @map("source_row_count")
  normalizedEntryCount  Int      @map("normalized_entry_count")
  createdByUserId       String   @map("created_by_user_id") @db.Uuid
  committedAt           DateTime @default(now()) @map("committed_at") @db.Timestamptz(3)

  timetableVersion TimetableVersion               @relation("TimetableImportReceiptVersion", fields: [timetableVersionId], references: [id], onDelete: Restrict)
  profileRevision  TimetableImportProfileRevision @relation(fields: [profileRevisionId], references: [id], onDelete: Restrict)
  createdBy        User                           @relation("TimetableImportReceiptCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([profileRevisionId], map: "timetable_import_receipts_profile_revision_id_idx")
  @@index([createdByUserId], map: "timetable_import_receipts_created_by_user_id_idx")
  @@map("timetable_import_receipts")
}

model TimetableEntry {
  id                   String          @id @default(uuid()) @db.Uuid
  timetableVersionId   String          @map("timetable_version_id") @db.Uuid
  academicYearId       String          @map("academic_year_id") @db.Uuid
  weekday              AcademicWeekday
  timeSlotDefinitionId String          @map("time_slot_definition_id") @db.Uuid
  schoolClassId        String          @map("school_class_id") @db.Uuid
  subjectId            String          @map("subject_id") @db.Uuid
  teachingAssignmentId String          @map("teaching_assignment_id") @db.Uuid
  teacherUserId        String          @map("teacher_user_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  timetableVersion   TimetableVersion   @relation("TimetableEntryVersion", fields: [timetableVersionId, academicYearId], references: [id, academicYearId], onDelete: Restrict)
  academicYear       AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  timeSlotDefinition TimeSlotDefinition @relation("TimetableEntryTimeSlot", fields: [timeSlotDefinitionId, academicYearId, weekday], references: [id, academicYearId, weekday], onDelete: Restrict)
  schoolClass        SchoolClass        @relation("TimetableEntrySchoolClass", fields: [schoolClassId, academicYearId], references: [id, academicYearId], onDelete: Restrict)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teachingAssignment TeachingAssignment @relation("TimetableEntryAssignment", fields: [teachingAssignmentId, academicYearId, schoolClassId, subjectId, teacherUserId], references: [id, academicYearId, schoolClassId, subjectId, teacherUserId], onDelete: Restrict)
  teacher            User               @relation("TimetableEntryTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)

  @@unique([timetableVersionId, weekday, timeSlotDefinitionId, schoolClassId], map: "timetable_entries_class_exact_slot_key")
  @@unique([timetableVersionId, weekday, timeSlotDefinitionId, teacherUserId], map: "timetable_entries_teacher_exact_slot_key")
  @@index([timetableVersionId, schoolClassId], map: "timetable_entries_version_class_idx")
  @@index([timetableVersionId, teacherUserId], map: "timetable_entries_version_teacher_idx")
  @@index([timetableVersionId, subjectId], map: "timetable_entries_version_subject_idx")
  @@index([timetableVersionId, teachingAssignmentId], map: "timetable_entries_version_assignment_idx")
  @@index([academicYearId, weekday, timeSlotDefinitionId], map: "timetable_entries_year_weekday_slot_idx")
  @@map("timetable_entries")
}
