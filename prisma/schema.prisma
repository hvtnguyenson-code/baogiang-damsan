// ============================================================
// prisma/schema.prisma
// Prisma schema for baogiang-damsan
//
// Phase 01: Identity, access, organizational assignment, and audit foundation.
//
// Database: PostgreSQL 17; connection supplied through DATABASE_URL per environment.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// System setting model for metadata and phase tracking
model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  DISABLED
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILURE
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String     @unique @db.VarChar(100)
  passwordHash       String     @map("password_hash") @db.Text
  status             UserStatus @default(PENDING)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile                          StaffProfile?
  subjectGroupMemberships          SubjectGroupMembership[]
  staffSubjects                    StaffSubject[]
  capabilityGrants                 CapabilityGrant[]               @relation("CapabilityGrantSubject")
  capabilityGrantsCreated          CapabilityGrant[]               @relation("CapabilityGrantGrantedBy")
  capabilityGrantsRevoked          CapabilityGrant[]               @relation("CapabilityGrantRevokedBy")
  authSessions                     AuthSession[]
  auditEvents                      AuditEvent[]                    @relation("AuditActor")
  additionalDutyAssignmentsCreated StaffAdditionalDutyAssignment[] @relation("AdditionalDutyAssignmentCreator")

  @@index([status])
  @@map("users")
}

model StaffProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  staffCode       String?  @unique @map("staff_code") @db.VarChar(50)
  displayName     String   @map("display_name") @db.VarChar(150)
  email           String?  @db.VarChar(254)
  phone           String?  @db.VarChar(30)
  positionTitle   String?  @map("position_title") @db.VarChar(150)
  isTeachingStaff Boolean  @default(true) @map("is_teaching_staff")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                      User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  additionalDutyAssignments StaffAdditionalDutyAssignment[]

  @@map("staff_profiles")
}

model SubjectGroup {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique @db.VarChar(50)
  name      String        @db.VarChar(150)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships SubjectGroupMembership[]

  @@index([status, code])
  @@map("subject_groups")
}

model Subject {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique @db.VarChar(50)
  name      String        @db.VarChar(150)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  staffSubjects StaffSubject[]

  @@index([status, code])
  @@map("subjects")
}

model SubjectGroupMembership {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  subjectGroupId String    @map("subject_group_id") @db.Uuid
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(3)
  isPrimary      Boolean   @default(false) @map("is_primary")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  subjectGroup SubjectGroup @relation(fields: [subjectGroupId], references: [id], onDelete: Restrict)

  @@index([userId, validFrom, validUntil])
  @@index([subjectGroupId, validFrom, validUntil])
  @@map("subject_group_memberships")
}

model StaffSubject {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  subjectId  String    @map("subject_id") @db.Uuid
  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([userId, validFrom, validUntil])
  @@index([subjectId, validFrom, validUntil])
  @@map("staff_subjects")
}

model CapabilityDefinition {
  key               String   @id @db.VarChar(100)
  description       String   @db.Text
  allowedScopeTypes String[] @map("allowed_scope_types")
  isSystem          Boolean  @default(true) @map("is_system")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  grants CapabilityGrant[]

  @@index([isActive, key])
  @@map("capability_definitions")
}

model CapabilityGrant {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  capabilityKey   String    @map("capability_key") @db.VarChar(100)
  scopeType       String    @map("scope_type") @db.VarChar(50)
  scopeResourceId String?   @map("scope_resource_id") @db.Uuid
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil      DateTime? @map("valid_until") @db.Timestamptz(3)
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokeReason    String?   @map("revoke_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User                 @relation("CapabilityGrantSubject", fields: [userId], references: [id], onDelete: Restrict)
  capability CapabilityDefinition @relation(fields: [capabilityKey], references: [key], onDelete: Restrict)
  grantedBy  User?                @relation("CapabilityGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedBy  User?                @relation("CapabilityGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, capabilityKey, revokedAt, validFrom, validUntil])
  @@index([scopeType, scopeResourceId, validFrom, validUntil])
  @@map("capability_grants")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      String      @db.VarChar(100)
  entityType  String      @map("entity_type") @db.VarChar(100)
  entityId    String?     @map("entity_id") @db.VarChar(100)
  requestId   String?     @map("request_id") @db.VarChar(100)
  result      AuditResult @default(SUCCESS)
  metadata    Json?       @db.JsonB
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, result, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

model AdditionalDutyDefinition {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(150)
  description String?   @db.Text
  category    String    @db.VarChar(100)
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil  DateTime? @map("valid_until") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments StaffAdditionalDutyAssignment[]

  @@index([isActive, validFrom, validUntil, sortOrder])
  @@index([category, isActive])
  @@map("additional_duty_definitions")
}

model StaffAdditionalDutyAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  staffProfileId   String    @map("staff_profile_id") @db.Uuid
  dutyDefinitionId String    @map("duty_definition_id") @db.Uuid
  scopeType        String    @map("scope_type") @db.VarChar(50)
  scopeResourceId  String?   @map("scope_resource_id") @db.Uuid
  validFrom        DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil       DateTime? @map("valid_until") @db.Timestamptz(3)
  note             String?   @db.Text
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  staffProfile   StaffProfile             @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  dutyDefinition AdditionalDutyDefinition @relation(fields: [dutyDefinitionId], references: [id], onDelete: Restrict)
  createdBy      User                     @relation("AdditionalDutyAssignmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([staffProfileId, validFrom, validUntil])
  @@index([dutyDefinitionId, validFrom, validUntil])
  @@index([scopeType, scopeResourceId, validFrom, validUntil])
  @@map("staff_additional_duty_assignments")
}
