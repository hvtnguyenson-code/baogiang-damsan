# ============================================================
# apps/api/.env.example
# Environment variables for @baogiang/api
#
# Copy this file to .env only when a local command needs environment values.
# NEVER commit .env files with real credentials.
# ============================================================

# ---- Application ----
NODE_ENV=development
# Canonical business timezone. Production requires this exact value.
TZ=Asia/Ho_Chi_Minh

# ---- Server ----
# API binds to localhost only for security
API_HOST=127.0.0.1
API_PORT=3100
# Express trusts no forwarding hop locally. Current production topology has exactly one Nginx hop.
HTTP_TRUST_PROXY_HOPS=0

# ---- Database ----
# Supplied by the runtime environment. PostgreSQL is not required on the local machine.
# Do not place official VPS credentials in this repository or expose PostgreSQL publicly.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?schema=public

# Supplied by CI or another approved isolated test environment.
TEST_DATABASE_URL=postgresql://<test-user>:<test-password>@<test-host>:<port>/<test-database>?schema=public

# ---- CORS ----
# Frontend development origin (comma-separated for multiple)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Authentication/session ----
# Production must use Secure cookies. Values below are local-development examples.
AUTH_SESSION_TTL_SECONDS=28800
AUTH_LAST_SEEN_UPDATE_SECONDS=300
AUTH_COOKIE_NAME=baogiang_session
AUTH_COOKIE_PATH=/api
# Leave unset unless an approved deployment requires an explicit cookie domain.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_SECONDS=900
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_MAX_KEYS=10000

# Bootstrap is an explicit one-time CLI operation. Never commit real values.
BOOTSTRAP_ADMIN_USERNAME=<provided-at-runtime>
BOOTSTRAP_ADMIN_DISPLAY_NAME=<provided-at-runtime>
BOOTSTRAP_ADMIN_PASSWORD=<provided-at-runtime>

# ---- Feature Flags ----
# AI feature: MUST remain false until Phase AI is approved
AI_ENABLED=false
AI_ACTIVE_MODE_ENABLED=false
AI_PASSIVE_MODE_ENABLED=false

# Web Push: disabled in Phase 00
WEB_PUSH_ENABLED=false

# ---- Logging ----
LOG_LEVEL=debug
