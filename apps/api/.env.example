# ============================================================
# apps/api/.env.example
# Environment variables for @baogiang/api
#
# Copy this file to .env for local development.
# NEVER commit .env files with real credentials.
# ============================================================

# ---- Application ----
NODE_ENV=development

# ---- Server ----
# API binds to localhost only for security
API_HOST=127.0.0.1
API_PORT=3100

# ---- Database ----
# Local development database (no password - uses local trust auth)
DATABASE_URL=postgresql://baogiang_dev_user@127.0.0.1:5432/baogiang_dev?schema=public

# Local test database (no password - uses local trust auth)
TEST_DATABASE_URL=postgresql://baogiang_test_user@127.0.0.1:5432/baogiang_test?schema=public

# ---- CORS ----
# Frontend development origin (comma-separated for multiple)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Feature Flags ----
# AI feature: MUST remain false until Phase AI is approved
AI_ENABLED=false
AI_ACTIVE_MODE_ENABLED=false
AI_PASSIVE_MODE_ENABLED=false

# Web Push: disabled in Phase 00
WEB_PUSH_ENABLED=false

# ---- Logging ----
LOG_LEVEL=debug
