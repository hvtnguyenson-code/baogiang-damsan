{
  "name": "@baogiang/api",
  "version": "0.0.1",
  "description": "Backend API - Hệ thống Báo giảng Đam San",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/apps/api/src/main.js",
    "start:debug": "nest start --debug --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test:unit": "jest --testPathIgnorePatterns=\"integration\" --passWithNoTests",
    "test:integration": "jest --testPathPattern=\"\\.integration\\.spec\\.ts$\" --passWithNoTests",
    "test": "jest --passWithNoTests",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../../prisma/schema.prisma",
    "prisma:studio": "prisma studio",
    "bootstrap:admin": "ts-node -r tsconfig-paths/register src/bootstrap/bootstrap-admin.ts"
  },
  "dependencies": {
    "@baogiang/config": "*",
    "@baogiang/contracts": "*",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/terminus": "^10.2.0",
    "@prisma/client": "^5.14.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  }
}
