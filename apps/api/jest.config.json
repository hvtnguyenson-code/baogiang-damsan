{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": "\\.(spec|integration\\.spec)\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.test.json"
      }
    ]
  },
  "collectCoverageFrom": ["src/**/*.(t|j)s", "!src/main.ts"],
  "coverageDirectory": "./coverage",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/helpers/test-database-safety.setup.ts"],
  "moduleNameMapper": {
    "^@baogiang/contracts$": "<rootDir>/../../packages/contracts/src/index.ts",
    "^@baogiang/config$": "<rootDir>/../../packages/config/src/index.ts"
  }
}
